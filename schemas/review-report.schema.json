{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://velinstyle.info/schemas/review-report.schema.json",
  "title": "VelinStyle Review Report",
  "type": "object",
  "required": ["version", "scores", "issues"],
  "properties": {
    "version": { "type": "integer" },
    "promptScore": { "type": "number" },
    "scores": {
      "type": "object",
      "properties": {
        "design": { "type": "number" },
        "accessibility": { "type": "number" },
        "seo": { "type": "number" },
        "performance": { "type": "number" },
        "conversion": { "type": "number" },
        "visual": { "type": "number" }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["error", "warning", "info"] },
          "message": { "type": "string" },
          "fix": { "type": "string" }
        }
      }
    },
    "gate": { "type": "string", "enum": ["pass", "warn", "fail"] }
  }
}
